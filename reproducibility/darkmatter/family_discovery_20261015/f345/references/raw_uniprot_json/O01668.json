  "comments": [
    {
      "texts": [
        {
          "value": "Visual pigments are the light-absorbing molecules that mediate vision. They consist of an apoprotein, opsin, covalently linked to cis-retinal"
        }
      ],
      "commentType": "FUNCTION"
    },
    {
      "commentType": "SUBCELLULAR LOCATION",
      "subcellularLocations": [
