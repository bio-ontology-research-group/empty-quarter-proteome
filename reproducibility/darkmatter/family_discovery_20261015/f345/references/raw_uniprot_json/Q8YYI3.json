    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000250",
              "source": "UniProtKB",
              "id": "Q03513"
            },
            {
              "evidenceCode": "ECO:0000250",
              "source": "UniProtKB",
              "id": "Q8DKB5"
            }
          ],
          "value": "Probable homotrimer; zinc is bound between adjacent monomers (By similarity). Full length protein (M58) interacts with CcmN. The C-terminal RbcS-like domains (SSUL) bind to holo-RuBisCO, as does the M35 short form (By similarity)"
        }
      ],
      "commentType": "SUBUNIT"
    },
    {
      "commentType": "SUBCELLULAR LOCATION",
      "note": {
        "texts": [
          {
            "evidences": [
              {
                "evidenceCode": "ECO:0000269",
                "source": "PubMed",
                "id": "24907906"
              }
            ],
            "value": "This cyanobacterium makes beta-type carboxysomes. Both isoforms are found equally distributed in the interior of the carboxysome. An unexpectedly large amount is found outside the carboxysome by immungold labelling, this might represent coalescing RuBisCO-CcmM"
          }
        ]
      },
