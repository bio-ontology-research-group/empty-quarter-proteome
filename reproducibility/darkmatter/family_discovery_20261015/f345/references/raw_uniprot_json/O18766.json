    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000250",
              "source": "UniProtKB",
              "id": "P08100"
            }
          ],
          "value": "Contains one covalently linked retinal chromophore. Upon light absorption, the covalently bound 11-cis-retinal is converted to all-trans-retinal. Following activation, the covalently bound all-trans-retinal is released through hydrolysis of the Schiff base, and rhodopsin is regenerated by binding a new 11-cis-retinal molecule"
        }
      ],
      "commentType": "PTM"
    },
