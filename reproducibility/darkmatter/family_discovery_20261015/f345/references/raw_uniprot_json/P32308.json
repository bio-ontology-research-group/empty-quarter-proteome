    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000250",
              "source": "UniProtKB",
              "id": "P02699"
            }
          ],
          "value": "Phosphorylated on some or all of the serine and threonine residues present in the C-terminal region (By similarity)"
        }
      ],
      "commentType": "PTM"
    },
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000250",
              "source": "UniProtKB",
              "id": "P08100"
            }
          ],
          "value": "Contains one covalently linked retinal chromophore. Upon light absorption, the covalently bound 11-cis-retinal is converted to all-trans-retinal. Following activation, the covalently bound all-trans-retinal is released through hydrolysis of the Schiff base, and rhodopsin is regenerated by binding a new 11-cis-retinal molecule"
        }
      ],
      "commentType": "PTM"
    },
    {
      "commentType": "DISEASE",
      "note": {
        "texts": [
          {
            "evidences": [
              {
                "evidenceCode": "ECO:0000269",
                "source": "PubMed",
                "id": "11972042"
              }
            ],
            "value": "Defects in RHO are a cause of autosomal dominant retinitis pigmentosa (ADRP). The phenotypic features shared by dog and man include a dramatically slowed time course of recovery of rod photoreceptor function after light exposure and a distinctive topographic pattern to the retinal degeneration. This disease was identified in the English mastiff breed"
          }
        ]
      }
    },
    {
      "texts": [
        {
          "evidences": [
            {
