    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "8890170"
            }
          ],
          "value": "Expressed at low levels at 37 degrees Celsius, barely detectable at 26 degrees Celsius; expression is repressed by hns and partially activated by lrp (PubMed:8890170)"
        }
      ],
      "commentType": "INDUCTION"
    },
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "17267410"
            }
          ],
          "value": "Both the N-terminus (residues 1-76) and the C-terminus (residues 90-134) have RNA chaperone activity for splicing of td, a bacteriophage T4 pre-mRNA (PubMed:17267410)"
        }
      ],
      "commentType": "DOMAIN"
    },
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "23543115"
            },
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "8890170"
            }
          ],
          "value": "No visible phenotype in rich medium; double hns-stpA mutants grow slower and have reduced viable cell counts compared to single hns mutants in MC1029 and MC4100 backgrounds (PubMed:8890170). In 0.3M NaCl a double hns-stpA deletion up-regulates 583 and down-regulates 86 genes, 363 of which are thought to have been horizontally acquired; 131 are also up-regulated in a double cnu-hha deletion (PubMed:23543115)"
        }
      ],
      "commentType": "DISRUPTION PHENOTYPE"
    },
    {
