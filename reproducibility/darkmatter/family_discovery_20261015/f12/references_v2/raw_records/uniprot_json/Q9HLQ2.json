    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "14555659"
            }
          ],
          "value": "Catalyzes the dephosphorylation of 2-phosphoglycolate. Also has significant, but less efficient, pyrophosphatase activity, since it is able to catalyze the release of phosphate from inorganic pyrophosphate (PPi)"
        }
      ],
      "commentType": "FUNCTION"
    },
    {
      "commentType": "CATALYTIC ACTIVITY",
      "reaction": {
        "name": "2-phosphoglycolate + H2O = glycolate + phosphate",
