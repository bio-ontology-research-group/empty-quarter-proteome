  "comments": [
    {
      "texts": [
        {
          "value": "Involved in repair of UV radiation-induced DNA damage. Catalyzes the light-dependent monomerization (300-600 nm) of cyclobutyl pyrimidine dimers (in cis-syn configuration), which are formed between adjacent bases on the same DNA strand upon exposure to ultraviolet radiation"
        }
      ],
      "commentType": "FUNCTION"
    },
    {
      "commentType": "CATALYTIC ACTIVITY",
      "reaction": {
        "name": "cyclobutadipyrimidine (in DNA) = 2 pyrimidine residues (in DNA).",
        "ecNumber": "4.1.99.3"
      }
    },
    {
