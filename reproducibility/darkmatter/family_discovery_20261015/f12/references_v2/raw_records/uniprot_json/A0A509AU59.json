  "comments": [
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "30700551"
            }
          ],
          "value": "Phosphatase with activity against multiple substrates (PubMed:30700551). Acts as a metabolite repair enzyme which eliminates toxic glycolytic side products (PubMed:30700551). Dephosphorylates 2-phosphoglycolate which is generated during the repair of oxidative DNA lesions (PubMed:30700551). Dephosphorylates 2-phospho-L-lactate which is a product of a pyruvate kinase side reaction (PubMed:30700551). Stereospecific for 2-phospho-L-lactate, showing no activity with 2-phospho-D-lactate (PubMed:30700551)"
        }
      ],
      "commentType": "FUNCTION"
    },
