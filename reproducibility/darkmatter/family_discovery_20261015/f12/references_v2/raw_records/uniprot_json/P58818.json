  "comments": [
    {
      "texts": [
        {
          "value": "Involved in repair of UV radiation-induced DNA damage. Catalyzes the light-dependent monomerization (300-600 nm) of cyclobutyl pyrimidine dimers (in cis-syn configuration), which are formed between adjacent bases on the same DNA strand upon exposure to ultraviolet radiation"
        }
      ],
      "commentType": "FUNCTION"
    },
    {
      "commentType": "CATALYTIC ACTIVITY",
      "reaction": {
        "name": "cyclobutadipyrimidine (in DNA) = 2 pyrimidine residues (in DNA).",
        "ecNumber": "4.1.99.3"
      }
    },
    {
      "commentType": "COFACTOR",
      "cofactors": [
        {
          "name": "FAD",
          "cofactorCrossReference": {
            "database": "ChEBI",
            "id": "CHEBI:57692"
          }
        }
      ],
      "note": {
        "texts": [
          {
            "value": "Binds 1 FAD. The FAD is in its reduced state."
          }
        ]
      }
    },
    {
      "commentType": "COFACTOR",
      "cofactors": [
        {
          "name": "coenzyme F420-(gamma-Glu)n",
          "cofactorCrossReference": {
            "database": "ChEBI",
            "id": "CHEBI:133980"
          }
        }
      ],
      "note": {
        "texts": [
          {
            "value": "Binds 1 F420 non-covalently per subunit. The F420 is in its oxidized state."
          }
        ]
      }
    },
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000305"
            }
          ],
          "value": "Belongs to the DNA photolyase class-2 family"
        }
      ],
      "commentType": "SIMILARITY"
    }
